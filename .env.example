# Fernet encryption key (44-char base64)
# Generate (recommended): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate (alternative):  openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
ENCRYPTION_KEY=

# JWT signing secret
# Generate: openssl rand -hex 32
JWT_SECRET=

# Redis URL (docker-compose internal network)
REDIS_URL=redis://redis:6379/0

# SQLite path (docker-compose volume mount)
DATABASE_URL=sqlite:////app/data/meta.db
